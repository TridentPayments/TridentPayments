---
import { Picture } from 'astro:assets';
import ApplyButton from './ApplyButton.astro';
import heroImage from '../assets/hero-field-rep.jpg';
import { site } from '../config/site';
---

<section id="top" class="pt-24 pb-10 sm:pt-28 lg:pt-[104px] lg:pb-12" aria-labelledby="hero-title">
  <div id="opportunity" class="wrap grid items-center gap-10 lg:grid-cols-[minmax(0,1.04fr)_minmax(0,1fr)] lg:gap-12">
    <div>
      <p class="label flex items-center gap-2">
        {site.launch.state}<span aria-hidden="true" class="size-1 rounded-full bg-muted"></span>Full launch {site.launch.label}
      </p>
      <h1 id="hero-title" class="mt-5 text-[2.9rem] leading-[0.98] font-bold tracking-[-0.045em] sm:text-[4rem] lg:text-[4rem] xl:text-[4.5rem]">
        Build a book.<br />Build recurring income.
      </h1>
      <p class="mt-6 max-w-[34rem] text-[1.0625rem] leading-relaxed text-ink/80 sm:text-[1.125rem]">
        Trident Payments is launching in {site.launch.label}, and we’re building our founding sales bench across {site.launch.state}. Help local
        businesses take a fresh look at their card processing, and earn upfront commissions plus monthly residuals.
      </p>
      <ApplyButton location="hero" class="mt-8 w-full sm:w-auto" />
      <p class="mt-4 text-[0.875rem] text-muted">Part-time and full-time interest welcome. Independent 1099 opportunity.</p>
    </div>

    <figure class="relative overflow-hidden rounded-[22px] bg-card">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1280, 1600]}
        sizes="(min-width: 1200px) 620px, (min-width: 1024px) 52vw, calc(100vw - 32px)"
        alt="A Trident Payments field rep in a black branded polo walking past storefronts and palm trees on a sunny Florida street"
        loading="eager"
        fetchpriority="high"
        class="aspect-[3/2] h-auto w-full object-cover"
      />
      <figcaption
        class="absolute top-4 right-4 max-w-[13.5rem] rounded-2xl bg-white/90 px-5 py-4 text-[0.75rem] leading-[1.45] font-semibold tracking-[0.06em] text-ink uppercase shadow-sm backdrop-blur-md sm:top-5 sm:right-5 sm:text-[0.8125rem]"
      >
        Real businesses.<br />Real conversations.<br />Recurring income.
        <span class="mt-3 block h-px w-8 bg-ink/40" aria-hidden="true"></span>
      </figcaption>
    </figure>
  </div>
</section>
