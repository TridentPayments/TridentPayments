---
import Logo from './Logo.astro';
import ApplyButton from './ApplyButton.astro';
import HQLoginLink from './HQLoginLink.astro';

const links = [
  { href: '#opportunity', label: 'Opportunity' },
  { href: '#compensation', label: 'Compensation' },
  { href: '#work', label: 'The Work' },
  { href: '#markets', label: 'Markets' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300" data-header>
  <div class="wrap flex h-[72px] items-center justify-between gap-6">
    <a href="#top" class="rounded-md" aria-label="Trident Payments, back to top"><Logo /></a>
    <nav aria-label="Page sections" class="hidden md:block">
      <ul class="flex items-center gap-8 text-[0.875rem] text-ink/85">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="transition-colors hover:text-ink">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex shrink-0 items-center gap-2">
      <HQLoginLink placement="header" />
      <ApplyButton location="header" short />
    </div>
  </div>
</header>

<style>
  [data-header].is-scrolled {
    background-color: rgb(250 250 248 / 0.88);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom-color: var(--color-line);
  }
</style>
